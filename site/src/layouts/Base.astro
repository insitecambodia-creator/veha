---
interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  bodyClass?: string;
}
const { title, description, path, ogTitle = title, ogDescription = description } = Astro.props;
const canonical = new URL(path, 'https://www.veha.app').href;
const ogImage = 'https://www.veha.app/img/og.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#ffffff">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="VEHA Cloud POS">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700&family=Noto+Sans+Khmer:wght@400;600;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet">
  <script is:inline>document.documentElement.classList.add("js")</script>
  <link rel="stylesheet" href="/css/style.css">
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main" data-i18n="skip">Skip to content</a>
  <slot />
</body>
</html>
