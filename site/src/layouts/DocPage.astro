---
import Base from './Base.astro';
import DocHeader from '../components/DocHeader.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
---
<Base title={`${title} | VEHA Cloud POS`} description={description} path={path}>
  <DocHeader />
  <main id="main" class="doc">
    <div class="wrap narrow">
      <slot />
    </div>
  </main>
  <Footer />
</Base>
